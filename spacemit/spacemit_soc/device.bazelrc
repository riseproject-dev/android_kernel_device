# SpacemiT K3 Pico-ITX device bazelrc
#
# Usage:
#   ln -sf devices/rise/spacemit/spacemit_soc/device.bazelrc device.bazelrc
#   tools/bazel run //devices/rise/spacemit/spacemit_soc:spacemit_k3_dist
#
# Or with explicit device config:
#   tools/bazel run --config=spacemit_k3 //devices/rise/spacemit/spacemit_soc:spacemit_k3_dist

# Local build (disable sandboxing). Replaces the obsolete kleaf
# config_repo label_flag, removed during the android-mainline migration.
build:spacemit_k3 --config=local

# RISC-V target platform. @platforms//cpu:riscv64 is only a constraint_value;
# kleaf provides the actual riscv64 platform via the android_riscv64 config.
build:spacemit_k3 --config=android_riscv64
