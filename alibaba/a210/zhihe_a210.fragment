# ZhiHe A210 fragment for Android GKI
# Base: arch/riscv/configs/gki_defconfig
# Used by //devices/rise/alibaba/a210:zhihe_a210.
# Board peripherals are modules; Android loads storage drivers from vendor_boot.

# ============================================================
# Timer tick — bump HZ from 250 (RISC-V default) to 1000
# ============================================================
# RISC-V kernel defaults to HZ=250 (server-oriented).  Android UI runs
# at 60Hz so a 4ms tick can cost up to 25% of the 16.6ms frame budget
# in jiffies-based scheduling jitter.  HZ=1000 (ARM Android standard)
# reduces tick to 1ms (~6% of frame budget).  Kconfig HZ_* is a
# `choice` so we explicitly disable the others.
# CONFIG_HZ_100 is not set
# CONFIG_HZ_250 is not set
# CONFIG_HZ_300 is not set
CONFIG_HZ_1000=y

# ============================================================
# SoC Selection
# ============================================================
CONFIG_ARCH_ZHIHE=y

# ============================================================
# Vendor Options
# ============================================================
# CONFIG_RISCV_PROBE_VECTOR_UNALIGNED_ACCESS is the gki_defconfig
# default. Bisecting with maxcpus=N on real A210 hardware showed
# this reliably crashes (illegal instruction / OpenSBI trap) once 4
# or more harts are concurrently active.
# Picks the SLOW choice instead of PROBE, keeping Vector usable
# avoiding the crashing probe
CONFIG_RISCV_SLOW_VECTOR_UNALIGNED_ACCESS=y

# ============================================================
# Android mandatory configs missing from GKI defconfig
# ============================================================
# Cgroups
CONFIG_CGROUP_PIDS=y
CONFIG_PROC_PID_CPUSET=y

# Device nodes
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y

# Crypto (android-base.config)
CONFIG_CRYPTO_NULL=y
# dm-verity hashtrees are signed with sha1 (avbtool's backwards-compat default,
# not overridden in the device AVB args). The crypto-lib rework dropped SHA1's
# implicit enable, so crypto_alloc_shash("sha1") returns -ENOENT and verity
# fails to mount system. Register the sha1 shash explicitly.
CONFIG_CRYPTO_SHA1=y

# Netfilter (android-base.config)
CONFIG_IP_NF_MATCH_RPFILTER=y

# tmpfs SELinux support
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_TMPFS_XATTR=y

# TLS (required by GKI modules list - net/tls/tls.ko)
CONFIG_TLS=m

# DMA-BUF heaps (needed by minigbm/gralloc for buffer allocation)
CONFIG_DMABUF_HEAPS_SYSTEM=y
CONFIG_DMABUF_HEAPS_CMA=y

# Serial console — GKI defaults to RUNTIME_UARTS=0 which means no ttyS* ports
# are pre-allocated at boot. The 8250_of driver then fails to register because
# uart_add_one_port cannot match console=ttyS0. Set to 10 for A210 UARTs.
CONFIG_SERIAL_8250_RUNTIME_UARTS=10

# ============================================================
# Clock Drivers
# ============================================================
# CONFIG_CLK_A210 selects CONFIG_ZHIHE_CLK, but listed explicitly
# here too for visibility.
CONFIG_ZHIHE_CLK=m
CONFIG_CLK_A210=m

# ============================================================
# Reset Controller
# ============================================================
CONFIG_RESET_A210=m

# ============================================================
# Pinctrl
# ============================================================
CONFIG_PINCTRL_A210=m

# ============================================================
# Power Domain
# ============================================================
CONFIG_A210_POWER_DOMAIN=m

# ============================================================
# GPIO
# ============================================================
CONFIG_GPIO_DWAPB=m
CONFIG_GPIO_PCA953X=m
CONFIG_GPIO_PCA953X_IRQ=y

# ============================================================
# eMMC/SD host controller
# ============================================================
CONFIG_MMC_SDHCI_OF_DWCMSHC=m

# ============================================================
# UART - Using existing 8250 driver
# ============================================================
# Already enabled in gki_defconfig:
# CONFIG_SERIAL_8250=y
# CONFIG_SERIAL_8250_DW=y

# ============================================================
# Watchdog
# ============================================================
CONFIG_DW_WATCHDOG=m

# ============================================================
# USB 3.1 for adb (peripheral)
# ============================================================
# Already enabled in gki_defconfig:
# CONFIG_USB_DWC3_OF_SIMPLE=y
CONFIG_PHY_ZHIHE_SNPS_USB2=m
CONFIG_PHY_ZHIHE_SNPS_C10PHY=m

# ============================================================
# I2C
# ============================================================
CONFIG_I2C_DESIGNWARE_CORE=m
CONFIG_I2C_DESIGNWARE_PLATFORM=m

# ============================================================
# USB 2.0 for touch (host)
# ============================================================
CONFIG_USB_DWC2=m

# ============================================================
# TEMPORARY: VKMS boot-completion test
# ============================================================
CONFIG_DRM_VKMS=m

# ============================================================
# HDMI Video Output
# ============================================================
CONFIG_DRM_VERISILICON_DC=m
CONFIG_DRM_THEAD_TH1520_DW_HDMI=m
CONFIG_DRM_DISPLAY_CONNECTOR=m

# ============================================================
# PowerVR BXM GPU
# ============================================================
CONFIG_DRM_POWERVR=m

# ============================================================
# RTL8822CS WiFi (SDIO)
# ============================================================
CONFIG_PWRSEQ_SIMPLE=m
CONFIG_WLAN_VENDOR_REALTEK=y
CONFIG_RTW88=m
CONFIG_RTW88_8822CS=m
