# ============================================================
# Kernel Build
# ============================================================
ALIBABA_OUTS = [
    "Image",
    "Image.gz",
    "System.map",
    "modules.builtin",
    "modules.builtin.modinfo",
    "vmlinux",
    "vmlinux.symvers",
    # Device Tree Blobs
    "arch/riscv/boot/dts/zhihe/a210-evb.dtb",
]

kernel_build(
    name = "zhihe_a210",
    srcs = ["//common:kernel_riscv64_sources"],
    outs = ALIBABA_OUTS,
    arch = "riscv64",
    defconfig = "//common:arch/riscv/configs/gki_defconfig",
    make_goals = [
        "Image",
        "Image.gz",
        "modules",
        "zhihe/a210-evb.dtb",
    ],
    makefile = "//common:Makefile",
    module_outs = get_gki_modules_list("riscv64") +
                  get_kunit_modules_list("riscv64") +
                  ALIBABA_IN_TREE_MODULES_PATH +
                  ALIBABA_SYSTEM_DLKM_EXTRA_MODULES,
    pahole = "//common:pahole",
    pre_defconfig_fragments = [":zhihe_a210.fragment"],
    visibility = ["//visibility:public"],
)

# ============================================================
# Modules Install
# ============================================================
kernel_modules_install(
    name = "zhihe_a210_modules_install",
    kernel_build = ":zhihe_a210",
)

# ============================================================
# Module Lists (for Android module loading)
# ============================================================
write_file(
    name = "zhihe_a210_vendor_boot_modules_list",
    out = "vendor_boot_modules.zhihe_a210",
    content = ALIBABA_VENDOR_BOOT_MODULES,
)

write_file(
    name = "zhihe_a210_vendor_dlkm_modules_list",
    out = "vendor_dlkm_modules.zhihe_a210",
    content = ALIBABA_VENDOR_DLKM_MODULES,
)

# ============================================================
# Initramfs (vendor_boot ramdisk)
# ============================================================
initramfs(
    name = "zhihe_a210_initramfs",
    kernel_modules_install = ":zhihe_a210_modules_install",
    modules_list = ":zhihe_a210_vendor_boot_modules_list",
    ramdisk_compression = "lz4",
    trim_unused_modules = True,
    vendor_boot_name = "vendor_boot",
)

# ============================================================
# Vendor DLKM image (ext4 partition with vendor modules)
# ============================================================
vendor_dlkm_image(
    name = "zhihe_a210_vendor_dlkm_image",
    build_flatten = True,
    kernel_modules_install = ":zhihe_a210_modules_install",
    modules_list = ":zhihe_a210_vendor_dlkm_modules_list",
    vendor_boot_modules_load = ":zhihe_a210_initramfs",
)

# ============================================================
# Package files for distribution
# ============================================================

# Kernel image, System.map, modules.builtin, and DTBs (flattened).
pkg_files(
    name = "zhihe_a210_pkg_files",
    srcs = [":zhihe_a210/" + o for o in ALIBABA_OUTS],
    strip_prefix = strip_prefix.files_only(),
)

# Package individual .ko files for distribution
pkg_files(
    name = "zhihe_a210_ramdisk_modules_pkg_files",
    srcs = [":zhihe_a210_ramdisk_modules_filtered"],
    prefix = "ramdisk",
    strip_prefix = strip_prefix.files_only(),
)

pkg_files(
    name = "zhihe_a210_vendor_dlkm_modules_pkg_files",
    srcs = [":zhihe_a210_vendor_dlkm_modules_filtered"],
    prefix = "vendor_dlkm",
    strip_prefix = strip_prefix.files_only(),
)

pkg_files(
    name = "zhihe_a210_system_dlkm_modules_pkg_files",
    srcs = [":zhihe_a210_system_dlkm_modules_filtered"],
    prefix = "system_dlkm",
    strip_prefix = strip_prefix.files_only(),
)

# Actual vendor_dlkm.img / vendor_dlkm.flatten.img, for reference/verification
# (the flat .ko dump above is what the AOSP device tree actually consumes).
pkg_files(
    name = "zhihe_a210_vendor_dlkm_image_pkg_files",
    srcs = [":zhihe_a210_vendor_dlkm_image"],
    prefix = "vendor_dlkm",
    strip_prefix = strip_prefix.files_only(),
)

# Initramfs (initramfs.img, modules.load, vendor_boot.modules.load), for
# reference/verification - lets you inspect the vendor_boot ramdisk's raw
# contents and module load order directly, without extracting them from
# vendor_boot.img.
pkg_files(
    name = "zhihe_a210_initramfs_pkg_files",
    srcs = [":zhihe_a210_initramfs"],
    prefix = "initramfs",
    strip_prefix = strip_prefix.files_only(),
)

# ============================================================
# Genrules to extract individual modules from kernel_build outputs into
# per-partition subdirectories.
# ============================================================

# Extract vendor boot / ramdisk modules (SoC-critical early boot: clock,
# reset, pinctrl, power domain, GPIO, eMMC/SD, watchdog)
genrule(
    name = "zhihe_a210_ramdisk_modules_filtered",
    srcs = [":zhihe_a210"],
    outs = ["ramdisk_ko/" + mod for mod in ALIBABA_VENDOR_BOOT_MODULES],
    cmd = """
        declare -A MODMAP
        for f in $(SRCS); do
            b=$$(basename "$$f")
            [[ "$$b" == *.ko ]] && MODMAP["$$b"]="$$f"
        done
        for out in $(OUTS); do
            modname=$$(basename "$$out")
            src="$${MODMAP[$$modname]:-}"
            if [ -n "$$src" ]; then
                cp "$$src" "$$out"
            else
                echo "ERROR: Module $$modname not found in kernel build" >&2
                exit 1
            fi
        done
    """,
)

# Extract vendor DLKM modules (loaded after boot from eMMC: USB3.1 gadget,
# not needed to mount rootfs or in recovery - see ALIBABA_VENDOR_DLKM_MODULES)
genrule(
    name = "zhihe_a210_vendor_dlkm_modules_filtered",
    srcs = [":zhihe_a210"],
    outs = ["vendor_dlkm_ko/" + mod for mod in ALIBABA_VENDOR_DLKM_MODULES],
    cmd = """
        declare -A MODMAP
        for f in $(SRCS); do
            b=$$(basename "$$f")
            [[ "$$b" == *.ko ]] && MODMAP["$$b"]="$$f"
        done
        for out in $(OUTS); do
            modname=$$(basename "$$out")
            src="$${MODMAP[$$modname]:-}"
            if [ -n "$$src" ]; then
                cp "$$src" "$$out"
            else
                echo "ERROR: Module $$modname not found in kernel build" >&2
                exit 1
            fi
        done
    """,
)

# Extract system DLKM modules (generic GKI modules + the non-GKI
# ALIBABA_SYSTEM_DLKM_EXTRA_MODULES; kunit test modules are
# deliberately excluded here: they are not restaged by this dist target
# and are never packaged into system_dlkm).
genrule(
    name = "zhihe_a210_system_dlkm_modules_filtered",
    srcs = [":zhihe_a210"],
    outs = ["system_dlkm_ko/" + mod.split("/")[-1] for mod in ALIBABA_GKI_MODULES + ALIBABA_SYSTEM_DLKM_EXTRA_MODULES],
    cmd = """
        declare -A MODMAP
        for f in $(SRCS); do
            b=$$(basename "$$f")
            [[ "$$b" == *.ko ]] && MODMAP["$$b"]="$$f"
        done
        for out in $(OUTS); do
            modname=$$(basename "$$out")
            src="$${MODMAP[$$modname]:-}"
            if [ -n "$$src" ]; then
                cp "$$src" "$$out"
            else
                echo "ERROR: Module $$modname not found in kernel build" >&2
                exit 1
            fi
        done
    """,
)

# ============================================================
# Distribution target
# ============================================================
pkg_install(
    name = "zhihe_a210_dist",
    srcs = [
        # Kernel images, System.map, and DTBs
        ":zhihe_a210_pkg_files",
        # Modules, organized into ramdisk/, vendor_dlkm/ and system_dlkm/
        ":zhihe_a210_ramdisk_modules_pkg_files",
        ":zhihe_a210_vendor_dlkm_modules_pkg_files",
        ":zhihe_a210_system_dlkm_modules_pkg_files",
        # vendor_dlkm.img / vendor_dlkm.flatten.img
        ":zhihe_a210_vendor_dlkm_image_pkg_files",
        # initramfs.img / modules.load / vendor_boot.modules.load
        ":zhihe_a210_initramfs_pkg_files",
    ],
    destdir = "out/zhihe_a210/dist",
)
